# Copy to .env and fill in. Never commit .env.

# SauceDemo target and test credentials (see https://www.saucedemo.com)
BASE_URL=https://www.saucedemo.com
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# AI-assisted locator healing (off by default; deterministic fallbacks always run)
SELF_HEALING_AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Live Anthropic smoke test gate - spends real credits, keep false for normal runs
RUN_LIVE_AI_SMOKE=false
